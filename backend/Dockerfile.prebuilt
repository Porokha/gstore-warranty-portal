# Pre-built backend Dockerfile
# Use this when backend is already built locally
# Build command: cd backend && npm install && npm run build
# Then use: docker compose -f docker-compose.prod.prebuilt.yml up -d

FROM node:18-alpine

# Build argument to bust cache - pass different value each time to force dist copy
ARG CACHE_BUST=1
RUN echo "Cache bust: ${CACHE_BUST}"

WORKDIR /app

# Install build dependencies for bcrypt (needed for native modules)
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package*.json ./

# Install only production dependencies (much faster)
RUN npm install --omit=dev --no-audit --no-fund

# Copy build timestamp first (this file changes on each build, busting cache)
# This ensures the dist folder is always fresh
COPY dist/.build-timestamp ./build-timestamp

# Copy pre-built application (assumes dist/ folder exists)
# The timestamp file above ensures this layer is rebuilt when dist changes
COPY dist ./dist

# Copy any other necessary files
COPY .env* ./

# Create uploads directory
RUN mkdir -p uploads

# Expose port
EXPOSE 3000

# Start application
CMD ["npm", "run", "start:prod"]

